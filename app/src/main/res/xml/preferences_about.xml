<?xml version="1.0" encoding="utf-8" ?>
<!-- Reorganized About Settings - Material 3 -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>

    <PreferenceCategory android:title="@string/settings_about">

        <Preference
            android:summary="@string/url_project"
            app:icon="@drawable/ic_baseline_info"
            android:title="@string/more"
        >
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/prirai/nira-browser/"
            >
                <extra android:name="SOURCE" android:value="SELF" />
            </intent>
        </Preference>

        <Preference
            android:key="pref_version"
            android:title="@string/version"
        />

        <Preference
            android:key="pref_version_geckoview"
            android:title="@string/geckoview"
        />

        <Preference
            android:key="pref_version_mozac"
            android:title="@string/mozac"
        />

    </PreferenceCategory>

    <!--
        Updates category - populated by AboutSettingsFragment at
        runtime. Switch + manual check + last-check summary. Debug
        builds hide the whole category because the auto-updater is
        no-op in dev (release-signing-key only).
    -->
    <PreferenceCategory
        android:key="pref_cat_updates"
        android:title="@string/settings_updates">

        <com.prirai.android.nira.settings.MaterialSwitchPreference
            android:key="pref_update_checks_enabled"
            android:title="@string/settings_update_checks_enabled_title"
            android:summary="@string/settings_update_checks_enabled_summary"
            android:defaultValue="false" />

        <Preference
            android:key="pref_update_check_now"
            android:title="@string/settings_update_check_now_title"
            android:summary="@string/settings_update_check_now_summary" />

        <Preference
            android:key="pref_update_last_check"
            android:title="@string/settings_update_last_check_title"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/licenses">

        <Preference
            android:summary="@string/mpl_license"
            android:title="@string/app_name"
        >
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://www.mozilla.org/en-US/MPL/2.0/"
            >
                <extra android:name="SOURCE" android:value="SELF" />
            </intent>
        </Preference>

        <Preference
            android:summary="@string/apache"
            android:title="@string/android_open_source_project"
        >
            <intent
                android:action="android.intent.action.VIEW"
                android:data="http://www.apache.org/licenses/LICENSE-2.0"
            >
                <extra android:name="SOURCE" android:value="SELF" />
            </intent>
        </Preference>

        <Preference
            android:summary="@string/mpl_license"
            android:title="@string/mozac"
        >
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://www.mozilla.org/en-US/MPL/2.0/"
            >
                <extra android:name="SOURCE" android:value="SELF" />
            </intent>
        </Preference>

        <Preference
            android:summary="@string/mpl_license"
            android:title="@string/geckoview"
        >
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://www.mozilla.org/en-US/MPL/2.0/"
            >
                <extra android:name="SOURCE" android:value="SELF" />
            </intent>
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
