<?xml version="1.0" encoding="utf-8" ?>
<!--
  Top address-bar layout. Mirrored from Fenix's
  component_browser_top_toolbar.xml — BrowserToolbar with match_parent width,
  @dimen/browser_toolbar_height, gravity=top, no paddings or margins. The
  outer background carries a 1dp hairline divider on the bottom edge (see
  browser_toolbar_background_top.xml). Elevation and the inner URL pill drawable are
  applied at runtime in BrowserToolbarView.kt.

  clickable/focusable are set so the toolbar (not just the URL view) absorbs
  ripples and passes accessibility focus, matching Fenix's XML.
-->
<mozilla.components.browser.toolbar.BrowserToolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/browser_toolbar_height"
    android:layout_gravity="top"
    android:background="@drawable/browser_toolbar_background_top"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:browserToolbarClearColor="?android:attr/textColorPrimary"
    app:browserToolbarInsecureColor="?android:attr/textColorPrimary"
    app:browserToolbarMenuColor="?android:attr/textColorPrimary"
    app:browserToolbarProgressBarGravity="bottom"
    app:browserToolbarSecureColor="?android:attr/textColorPrimary"
    app:browserToolbarTrackingProtectionAndSecurityIndicatorSeparatorColor="?android:attr/textColorSecondary"
/>
