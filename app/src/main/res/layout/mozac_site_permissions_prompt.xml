<?xml version="1.0" encoding="utf-8"?>
<!--
    Nira override of mozilla-components' feature-sitepermissions prompt
    layout. AC's SitePermissionsDialogFragment.createContainer() inflates
    `R.layout.mozac_site_permissions_prompt` by name, so this file shadows
    the upstream resource at build time.

    AC calls setLayout(MATCH_PARENT, WRAP_CONTENT) + a transparent window
    background on the dialog window because BaseBrowserFragment passes
    `shouldWidthMatchParent = true`. That means our layout IS the dialog's
    visible chrome - we have to paint our own M3 surface, round the
    corners, and leave horizontal margins so the card doesn't go
    edge-to-edge.

    Contract: AC's `findViewById` casts in `createContainer()` require
    these IDs to stay as the exact View subclasses:

      @+id/icon             -> ImageView
      @+id/title            -> TextView
      @+id/message          -> TextView
      @+id/learn_more       -> TextView
      @+id/do_not_ask_again -> CheckBox
      @+id/deny_button      -> Button
      @+id/allow_button     -> Button

    Visual structure (Material 3 "basic dialog" variant):
      - Outer FrameLayout: full-width, transparent, 16dp side margins
        wrap the card so it floats as a centered card.
      - Inner MaterialCardView: 28dp corner radius (M3 extraLarge),
        colorSurfaceContainerHigh fill, 6dp elevation.
      - Content stack: 24dp padding, hero icon above title, body text,
        optional learn-more / do-not-ask-again, then button row.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start"
                android:importantForAccessibility="no"
                android:scaleType="center"
                app:tint="?attr/colorPrimary"
                tools:src="@android:drawable/ic_menu_camera"
                tools:tint="#6750A4" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Allow wikipedia.org to use your camera?" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="This is a message offering more context about the permission."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/learn_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mozac_feature_sitepermissions_learn_more_title"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
                android:checked="true" preselects the "Remember decision"
                box visually. AC's SitePermissionsDialogFragment calls
                `isChecked = shouldPreselectDoNotAskAgainCheckBox` on this
                view before attaching its OnCheckedChangeListener; because
                Nira passes `DialogConfig(shouldPreselectDoNotAskAgain =
                true)`, that programmatic set keeps the box checked AND
                initialises `userSelectionCheckBox = true` so a tap on
                Deny persists the decision without an extra tap on the
                checkbox. Matches the user's expectation that "my choice
                sticks unless I say otherwise".
            -->
            <CheckBox
                android:id="@+id/do_not_ask_again"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="@string/mozac_feature_sitepermissions_do_not_ask_again_on_this_site2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/deny_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/mozac_feature_sitepermissions_not_allow"
                    android:textAlignment="center"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/allow_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mozac_feature_sitepermissions_allow"
                    android:textAlignment="center"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
