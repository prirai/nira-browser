<?xml version="1.0" encoding="utf-8" ?>
<!--
  Inner URL-pill background used by:
    - BrowserToolbarView.init → display.setUrlBackground(...)
      (via ToolbarIntegration.updateSecurityBackground for the browser
      address bar, and via the tab-preview / search-edit ToolbarView).
    - fragment_home.xml, tab_preview.xml as a static rounded surface.

  Mirrored from Fenix's search_url_background.xml — a plain rounded rectangle
  filled with the "layerSearch" surface. On our Material 3 palette that maps
  to ?attr/colorSurfaceContainerHigh, one tonal step above the outer
  BrowserToolbar background (?attr/colorSurface) so the pill silhouette
  reads clearly against the surround.

  No ripple: Fenix does not put a stateful selector here because AC's
  DisplayToolbar already handles the URL-click hit target and highlight via
  the child mozac_browser_toolbar_url_view. A ripple on the pill's ImageView
  competes with that and produces a stuck highlight on tap.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceContainerHigh" />

    <corners android:radius="8dp" />
</shape>
